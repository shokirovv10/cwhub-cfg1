# === CwHUB CFG environment variables ===
# Nusxa oling: cp .env.example .env  (Windowsda: copy .env.example .env)

# Flask
FLASK_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
FLASK_ENV=development
FLASK_DEBUG=1

# Database (development uchun SQLite, keyinchalik PostgreSQL URIga almashtiring)
DATABASE_URL=sqlite:///cwhub.db
# Production misoli: postgresql://user:password@localhost:5432/cwhub_cfg

# Upload cheklovlari
MAX_CONTENT_LENGTH_MB=25
UPLOAD_FOLDER=uploads

# Admin seed (init_db.py birinchi marta ishga tushganda shu admin yaratiladi)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cwhub.local
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# ==== Manual to'lov (hozircha default qiymatlar, Admin Panel -> Payment Settings orqali o'zgartiriladi) ====
DEFAULT_VISA_NUMBER=4916 9903 3115 9134
DEFAULT_HUMO_NUMBER=9860 1966 1826 0687
DEFAULT_CARD_OWNER=Humo "Shakirov Sh" | Visa So'm "Shakirov Sh"
# ==== Kelajakdagi payment providerlar uchun PLACEHOLDER (hozircha bo'sh, hech narsa o'ylab topilmagan) ====
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

PAYMENT_API_ENABLED=false

# Rate limiting storage (development uchun memory://, productionda redis:// tavsiya etiladi)
RATELIMIT_STORAGE_URI=memory://
